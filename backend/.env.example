# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=schoolclinic_db
# Managed MySQL (Aiven etc.): paste the CA certificate (PEM; \n escapes allowed)
DB_SSL_CA=

# Auth: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# First admin account, created on startup if missing (password: 12+ characters)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Comma-separated frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# Set to 1 when running behind a proxy (Render, Railway, Nginx)
TRUST_PROXY=
AUTH_RATE_LIMIT=20

# Optional: profile pictures on S3 (or any S3-compatible store)
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_URL=
